 * @var \Magento\Framework\Escaper $escaper
 */
$v = (array) $block->getData('values');
/** @var \Zero\Cms\ViewModel\Component $view */
$view = $block->getData('view');
?>
<?php
$image = $view->mediaUrl($v['image']['path']);
$center = $v['align'] === 'center';
?>
<section class="grid <?= $image ? 'lg:grid-cols-2' : '' ?> gap-8 lg:gap-12 items-center">
    <div class="flex flex-col gap-4 <?= $center && !$image ? 'items-center text-center mx-auto max-w-3xl' : '' ?>">
        <?php if ($v['eyebrow'] !== ''): ?>
            <span class="text-xs font-semibold uppercase tracking-widest text-base-content/70"><?= $escaper->escapeHtml($v['eyebrow']) ?></span>
        <?php endif; ?>
        <h2 class="text-4xl sm:text-5xl font-medium tracking-tight text-balance"><?= $escaper->escapeHtml($v['heading']) ?></h2>
        <?= /* @noEscape */ $view->paragraphs($v['text'], 'text-lg max-w-prose') ?>
        <?php if ($v['button']['url'] !== '' && $v['button']['label'] !== ''): ?>
            <a href="<?= $escaper->escapeUrl($v['button']['url']) ?>" class="btn btn-primary self-start <?= $center && !$image ? 'self-center' : '' ?>">
                <?= $escaper->escapeHtml($v['button']['label']) ?>
            </a>
        <?php endif; ?>
    </div>
    <?php if ($image): ?>
        <img src="<?= $escaper->escapeUrl($image) ?>" alt="<?= $escaper->escapeHtmlAttr($v['image']['alt']) ?>"
             fetchpriority="high" class="w-full aspect-[4/3] object-cover object-top bg-base-200">
    <?php endif; ?>
</section>
