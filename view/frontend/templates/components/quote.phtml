/** @var \Zero\Cms\ViewModel\Component $view */
$view = $block->getData('view');
?>
<figure class="flex flex-col gap-4 max-w-3xl border-s-4 border-primary ps-6">
    <blockquote class="font-display text-3xl sm:text-4xl leading-snug text-balance">
        <?= /* @noEscape */ $view->paragraphs($v['text']) ?>
    </blockquote>
    <?php if ($v['cite'] !== ''): ?>
        <figcaption class="text-sm font-semibold uppercase tracking-widest text-base-content/70"><?= $escaper->escapeHtml($v['cite']) ?></figcaption>
    <?php endif; ?>
</figure>
